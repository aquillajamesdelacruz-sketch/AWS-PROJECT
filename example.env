# Get an OAuth "Web application" client ID from https://console.cloud.google.com/apis/credentials
# and add your site (e.g. http://localhost:5173) under "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=
# Cloudinary (image uploads) - the preset must be UNSIGNED
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# URL of the deployed productInfo Cloud Function (firebase deploy --only functions), e.g.
# https://us-central1-akirafirebase.cloudfunctions.net/productInfo
# Without it the app falls back to microlink.io, which Shopee/Lazada often block.
VITE_PRODUCT_API_URL=
